#!/usr/bin/env python3
"""Mini interface graphique pour regler la luminosite des ecrans.

- Une jauge "Les deux" en haut qui regle HDMI-1 et HDMI-2 simultanement.
- Une jauge par ecran pour le reglage individuel.
- Bouton "Defaut (90%)" et bouton "Appliquer".
"""

import subprocess
import os
import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk


def xrandr_outputs():
    out = subprocess.run(["xrandr", "--current"], capture_output=True, text=True)
    return [line.split()[0] for line in out.stdout.splitlines() if " connected" in line]


def apply_brightness(output, value):
    env = os.environ.copy()
    env["DISPLAY"] = ":0"
    env["XAUTHORITY"] = "/var/run/lightdm/root/:0"
    subprocess.run(
        ["xrandr", "--output", output, "--brightness", f"{value:.2f}"],
        env=env, check=False,
    )


class BrightnessApp(Gtk.Window):
    def __init__(self):
        super().__init__(title="Luminosite")
        self.set_border_width(10)
        self.set_default_size(440, -1)
        self.set_resizable(False)

        self.outputs = xrandr_outputs()
        if not self.outputs:
            self.outputs = ["HDMI-1", "HDMI-2"]

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        self.add(outer)

        # ---------- Jauge "Les deux" ----------
        both_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        outer.pack_start(both_box, True, True, 0)

        both_header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        both_box.pack_start(both_header, True, True, 0)
        both_label = Gtk.Label()
        both_label.set_markup("<b>Les deux ecrans</b>")
        both_label.set_xalign(0)
        both_header.pack_start(both_label, True, True, 0)
        self.both_value_label = Gtk.Label(label="90 %")
        self.both_value_label.set_xalign(1)
        both_header.pack_start(self.both_value_label, False, False, 0)

        both_adj = Gtk.Adjustment(value=0.9, lower=0.2, upper=1.0, step_increment=0.05, page_increment=0.1)
        self.both_scale = Gtk.Scale(orientation=Gtk.Orientation.HORIZONTAL, adjustment=both_adj)
        self.both_scale.set_digits(2)
        self.both_scale.set_hexpand(True)
        self.both_scale.connect("value-changed", self.on_both_change)
        both_box.pack_start(self.both_scale, True, True, 0)

        # Separateur
        outer.pack_start(Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL), True, True, 0)

        # ---------- Jauges individuelles ----------
        self.scales = []
        for out in self.outputs:
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            outer.pack_start(box, True, True, 0)

            header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
            box.pack_start(header, True, True, 0)
            label = Gtk.Label()
            label.set_markup(f"<b>{out}</b>")
            label.set_xalign(0)
            header.pack_start(label, True, True, 0)
            value_label = Gtk.Label(label="90 %")
            value_label.set_xalign(1)
            header.pack_start(value_label, False, False, 0)

            adj = Gtk.Adjustment(value=0.9, lower=0.2, upper=1.0, step_increment=0.05, page_increment=0.1)
            scale = Gtk.Scale(orientation=Gtk.Orientation.HORIZONTAL, adjustment=adj)
            scale.set_digits(2)
            scale.set_hexpand(True)
            scale.connect("value-changed", self.on_indiv_change, out, value_label)
            box.pack_start(scale, True, True, 0)
            self.scales.append((out, scale, value_label))

        # ---------- Boutons ----------
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        outer.pack_start(row, True, True, 0)

        btn_default = Gtk.Button(label="Defaut (90%)")
        btn_default.connect("clicked", self.set_all, 0.9)
        row.pack_start(btn_default, True, True, 0)

        btn_apply = Gtk.Button(label="Appliquer")
        btn_apply.connect("clicked", self.apply_all)
        row.pack_start(btn_apply, True, True, 0)

        # Indicateur d'etat
        self.status = Gtk.Label(label="Pret")
        self.status.set_xalign(0)
        outer.pack_start(self.status, True, True, 0)

    def on_both_change(self, scale):
        """Le slider 'Les deux' met a jour les jauges individuelles + applique."""
        value = scale.get_value()
        self.both_value_label.set_text(f"{int(value * 100)} %")
        for _, scale_indiv, label_indiv in self.scales:
            scale_indiv.handler_block_by_func(self.on_indiv_change)
            scale_indiv.set_value(value)
            scale_indiv.handler_unblock_by_func(self.on_indiv_change)
            label_indiv.set_text(f"{int(value * 100)} %")
            apply_brightness(self.outputs[self.scales.index((_, scale_indiv, label_indiv))], value)
        self.status.set_text(f"Applique {int(value * 100)} % aux deux ecrans")

    def on_indiv_change(self, scale, out, label):
        """Une jauge individuelle est modifiee -> on l'applique et on met a jour l'indicateur."""
        value = scale.get_value()
        label.set_text(f"{int(value * 100)} %")
        apply_brightness(out, value)
        self.status.set_text(f"{out} reglee a {int(value * 100)} %")

    def set_all(self, _btn, value):
        self.both_scale.set_value(value)

    def apply_all(self, _btn):
        for out, scale, _ in self.scales:
            apply_brightness(out, scale.get_value())
        self.status.set_text("Reglages appliques")


def main():
    win = BrightnessApp()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
